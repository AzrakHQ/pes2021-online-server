# Whitelist: only the server, the player setup scripts and the protocol notes are published.
/*
!/.gitignore
!/README.md
!/LICENSE
!/install.sh
!/run.sh
!/run.ps1
!/docs/
!/.github/
!/server/
!/notes/
/notes/*
!/notes/network-map.html
!/notes/re/
/notes/re/*
!/notes/re/captures/
!/notes/re/errcode.py
!/notes/re/extract_schemas.py

# runtime data / secrets
server-data/
server/certs/
*.db
__pycache__/
*.pyc
.pytest_cache/
identity.key
server/mod/dinput8.dll
server/pesserver/_build.py
server/build/
server/dist/
*.spec
